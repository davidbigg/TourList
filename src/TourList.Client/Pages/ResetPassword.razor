@page "/reset-password"
@inject AuthApi Auth
@inject NavigationManager Nav

<PageTitle>TourList · Reset password</PageTitle>

<div class="page">
    <div class="page-card surface">
        <div class="page-head">
            <div class="t">Reset password</div>
            <div class="nav"><a href="/login">Log in</a></div>
        </div>
        <div class="page-body">
            @if (_done)
            {
                <div class="muted">Your password has been reset. You can now <a href="/login">log in</a>.</div>
            }
            else if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(Email))
            {
                <div class="err">This reset link is invalid or incomplete. Request a new one from <a href="/forgot-password">Forgot password</a>.</div>
            }
            else
            {
                <div class="muted">Resetting password for <strong>@Email</strong>.</div>
                <label class="field">
                    <span class="lbl">New password</span>
                    <input class="input" type="password" autocomplete="new-password" @bind="_password" @bind:event="oninput" />
                    <span class="muted">At least 8 characters.</span>
                </label>
                @if (_error is not null)
                {
                    <div class="err">@_error</div>
                }
            }
        </div>
        @if (!_done && !string.IsNullOrEmpty(Token) && !string.IsNullOrEmpty(Email))
        {
            <div class="page-foot">
                <button class="btn pri" disabled="@_busy" @onclick="SubmitAsync">@(_busy ? "Resetting…" : "Reset password")</button>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string _password = "";
    private string? _error;
    private bool _busy;
    private bool _done;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        if (await Auth.ResetPasswordAsync(Email!, Token!, _password))
        {
            _done = true;
        }
        else
        {
            _error = "Couldn't reset the password. The link may have expired.";
            _busy = false;
        }
    }
}
