@page "/forgot-password"
@inject AuthApi Auth

<PageTitle>TourList · Forgot password</PageTitle>

<div class="page">
    <div class="page-card surface">
        <div class="page-head">
            <div class="t">Forgot password</div>
            <div class="nav"><a href="/login">Log in</a></div>
        </div>
        <div class="page-body">
            @if (_sent)
            {
                <div class="muted">If an account exists for <strong>@_email</strong>, a password-reset link has been sent. Check your inbox.</div>
            }
            else
            {
                <label class="field">
                    <span class="lbl">Email</span>
                    <input class="input" type="email" autocomplete="username" @bind="_email" @bind:event="oninput" />
                </label>
            }
        </div>
        @if (!_sent)
        {
            <div class="page-foot">
                <button class="btn pri" disabled="@_busy" @onclick="SubmitAsync">@(_busy ? "Sending…" : "Send reset link")</button>
            </div>
        }
    </div>
</div>

@code {
    private string _email = "";
    private bool _busy;
    private bool _sent;

    private async Task SubmitAsync()
    {
        _busy = true;
        await Auth.ForgotPasswordAsync(_email);
        _sent = true; // always confirm — never reveal whether the account exists
        _busy = false;
    }
}
