<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="page">
                            <div class="page-card surface">
                                <div class="page-head"><div class="t">Not authorized</div><div class="nav"><a href="/">Map</a></div></div>
                                <div class="page-body"><div class="empty">You don't have access to this page.</div></div>
                            </div>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="page"><div class="page-card surface"><div class="page-body"><div class="empty">Loading…</div></div></div></div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
